# =============================================================================
# PRESITEN ("presistent") — Simulador de browser para manter a AKIRA UI
# (Render FREE) sem adormecer. Copia este ficheiro para ".env" e ajusta.
# Todos os valores abaixo sao os defaults de produção.
#   PowerShell:  $env:SIM_TOKEN = "..."
#   bash / zsh:  export SIM_TOKEN=...
# =============================================================================

# URL alvo da navegação (instância AKIRA UI na Render).
TARGET_URL=https://akira-ia.onrender.com

# Se definido (nao-vazio), /api/simulate exige este token: no header
# "x-presistent-token", em "Authorization: Bearer <token>" ou em "?token=".
# Vazio = endpoint aberto (cuidado em produção).
SIM_TOKEN=

# Habilita o round-trip real de chat (profile + POST /api/chat + polling).
# "true" no core (Actions/Docker/local); na cópia Vercel recomenda-se "false"
# para nao gastar a quota do convidado num ambiente serverless.
SIM_ENABLE_CHAT=true

# Horas UTC em que o chat e realmente enviado, separadas por vírgula.
# "9,15,21" => 3 chats/dia, com folga para o limite de 10 msgs/dia do
# convidado. "*" = todas as horas (usar com cuidado: pode esgotar a quota).
SIM_CHAT_HOURS=9,15,21

# "1" força o chat fora das horas definidas em SIM_CHAT_HOURS —
# apenas para testes/disparos manuais.
SIM_FORCE_CHAT=

# Tempo máximo (min, em segundos) de espera pela resposta da IA
# no polling do jobId.
SIM_CHAT_POLL_SECONDS=45

# Nº máximo de assets /_next/static pedidos por ronda.
SIM_ASSETS_MAX=3

# Timeout por pedido HTTP, em ms.
SIM_TIMEOUT_MS=15000

# Janela de pausa aleatória entre pedidos, em ms (formato "min,max") —
# simula navegação humana.
SIM_JITTER_MS=120,900

# Pasta onde e gravado o estado da sessão (cookie jar persistente).
# Retomar a sessão evita criar um utilizador novo na DB a cada ronda.
# Se a escrita falhar, a ronda continua sem estado (nao falha por isso).
SIM_STATE_DIR=sim/state

# Intervalo entre rondas no modo loop (node sim/loop.mjs / Docker), em
# segundos.
SIM_INTERVAL_SECONDS=180

# User-Agent fixo. Vazio = escolhido aleatoriamente por ronda, de um pool
# de Chrome modernos.
SIM_UA=

# ---- Seguintes: apenas secrets do GitHub Actions (nao se usam em .env) ------
# Se ambos definidos nos Secrets do Actions, a ronda do cron tambem dispara
# a mesma simulação na cópia Vercel (POST com header x-presistent-token).
# VERCEL_SIM_URL=https://presistent.vercel.app
# VERCEL_SIM_TOKEN=

# ---- Opcional, apenas na cópia Vercel ---------------------------------------
# Autentica o disparo do cron diário configurado no vercel.json.
# Vazio = cron sem verificação.
# CRON_SECRET=
