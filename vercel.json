{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/simulate",
      "schedule": "0 0 * * *"
    }
  ]
}
